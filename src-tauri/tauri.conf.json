{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot Bridge Atlas",
  "version": "6.0.6",
  "identifier": "com.alansprojects.copilotbridgeatlas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copilot Bridge Atlas",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-l9wN6Eftym+A8KEbz5kJloKNghY1hLhJEhzBtOoSueU='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": false,
    "licenseFile": "../BUNDLED_LICENSES.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "1b11a704-5fa6-4ce5-bfe2-7acd63e88f14",
        "language": "en-US",
        "template": "wix/per-user-main.wxs"
      }
    }
  }
}
